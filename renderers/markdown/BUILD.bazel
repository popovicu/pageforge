load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "markdown_lib",
    srcs = [
        "main.go",
        "toc.go",
    ],
    importpath = "github.com/popovicu/pageforge/renderers/markdown",
    visibility = ["//visibility:private"],
    deps = [
        "//renderers/core",
        "//third_party:chroma_html",
        "//third_party:goldmark",
        "//third_party:goldmark_ast",
        "//third_party:goldmark_extension",
        "//third_party:goldmark_highlighting",
        "//third_party:goldmark_parser",
        "//third_party:goldmark_renderer",
        "//third_party:goldmark_renderer_html",
        "//third_party:goldmark_text",
        "//third_party:goldmark_util",
    ],
)

go_binary(
    name = "markdown",
    embed = [":markdown_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "markdown_test",
    srcs = ["main_test.go"],
    embed = [":markdown_lib"],
    pure = "on",
    deps = ["//internal/testutil"],
)
