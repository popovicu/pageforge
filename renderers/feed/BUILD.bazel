load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "feed_lib",
    srcs = ["main.go"],
    importpath = "github.com/popovicu/pageforge/renderers/feed",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/templatefuncs",
        "//renderers/core",
    ],
)

go_binary(
    name = "feed",
    embed = [":feed_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "feed_test",
    srcs = ["main_test.go"],
    embed = [":feed_lib"],
    pure = "on",
    deps = ["//internal/testutil"],
)
