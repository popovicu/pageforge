load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "metadata_bundle_lib",
    srcs = ["main.go"],
    importpath = "github.com/popovicu/pageforge/renderers/metadata_bundle",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/templatefuncs",
        "//renderers/core",
        "//third_party:yaml",
    ],
)

go_binary(
    name = "metadata_bundle",
    embed = [":metadata_bundle_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "metadata_bundle_test",
    srcs = ["main_test.go"],
    embed = [":metadata_bundle_lib"],
    pure = "on",
    deps = [
        "//internal/testutil",
        "//third_party:yaml",
    ],
)
