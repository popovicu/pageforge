load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "template_lib",
    srcs = ["main.go"],
    importpath = "github.com/popovicu/pageforge/renderers/template",
    visibility = ["//visibility:private"],
    deps = ["//renderers/core"],
)

go_binary(
    name = "template",
    embed = [":template_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "template_test",
    srcs = ["main_test.go"],
    embed = [":template_lib"],
    pure = "on",
    deps = ["//internal/testutil"],
)
